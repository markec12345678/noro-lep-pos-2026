# Environment variables (example)
# Kopiraj to datoteko v .env in izpolni vrednosti

# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# FURS (Slovenian fiscal)
FURS_CERT_PATH="./certs/furs.p12"
FURS_CERT_PASSWORD="your-cert-password"
FURS_TAX_NUMBER="12345678"
FURS_ENVIRONMENT="test" # test | production

# Stripe (payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# WebSocket
WS_PORT="3003"

# Public API
PUBLIC_API_PORT="3005"

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Redis (optional, za production cache)
# REDIS_URL="redis://localhost:6379"
